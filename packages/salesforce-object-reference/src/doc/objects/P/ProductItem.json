{
  "ProductItem": {
    "name": "ProductItem",
    "description": "Represents the stock of a product at a particular inventory location, such as a warehouse or a distribution lot. Product item records represent your inventory. A product item is associated with an inventory location and stores the quantity of products at that location.",
    "properties": {
      "IsProduct2Serialized": {
        "type": "boolean",
        "description": "Specifies if the product associated with the product item is a serialized product (true) or not (false).",
        "nullable": false,
        "readOnly": true
      },
      "LastReferencedDate": {
        "type": "string",
        "description": "The timestamp when the current user last accessed this record indirectly, for example, through a list view or related record.",
        "format": "date-time",
        "nullable": true,
        "readOnly": true
      },
      "LastViewedDate": {
        "type": "string",
        "description": "The timestamp when the current user last viewed this record or list view. If this value is null, and LastReferenceDate isn’t null, the user accessed this record or list view indirectly.",
        "format": "date-time",
        "nullable": true,
        "readOnly": true
      },
      "LocationId": {
        "type": "string",
        "description": "The location that’s associated with the product item. This usually indicates where the product item is stored.",
        "format": "reference",
        "x-object": "Location",
        "maxLength": 18,
        "nullable": false,
        "readOnly": true
      },
      "OwnerId": {
        "type": "string",
        "description": "The owner of the product item.",
        "format": "reference",
        "x-objects": [
          "Group",
          "User"
        ],
        "maxLength": 18,
        "nullable": false
      },
      "Product2Id": {
        "type": "string",
        "description": "The product that’s associated with the product item. This usually represents the type of product in your inventory.",
        "format": "reference",
        "x-object": "Product2",
        "maxLength": 18,
        "nullable": false,
        "readOnly": true
      },
      "ProductItemNumber": {
        "type": "string",
        "description": "The auto-generated number identifying the product item.",
        "maxLength": 255,
        "nullable": false,
        "readOnly": true
      },
      "ProductName": {
        "type": "string",
        "description": "The name of the product item. We recommend you use a name that indicates the name of the product along with its location.",
        "maxLength": 255,
        "nullable": true,
        "readOnly": true
      },
      "QuantityOnHand": {
        "type": "double",
        "description": "The quantity at the location. If you want to add a serial number, this value must be 1.",
        "nullable": false,
        "multipleOf": 0.01
      },
      "QuantityUnitOfMeasure": {
        "type": "string",
        "description": "The unit of the quantity of the product that’s consumed. For example, kilograms or liters. Quantity Unit of Measure values are inherited from the Quantity Unit of Measure field on products.",
        "format": "enum",
        "enum": [
          "Each"
        ],
        "maxLength": 40,
        "nullable": true
      },
      "SerialNumber": {
        "type": "string",
        "description": "A unique number for identification purposes. If you want to enter a serial number, the Quantity on Hand must be 1.",
        "maxLength": 80,
        "nullable": true
      },
      "Id": {
        "type": "string",
        "description": "Product Item ID",
        "format": "salesforce-id",
        "maxLength": 18,
        "nullable": false,
        "readOnly": true
      },
      "IsDeleted": {
        "type": "boolean",
        "description": "Deleted",
        "nullable": false,
        "readOnly": true
      },
      "CreatedDate": {
        "type": "string",
        "format": "date-time",
        "nullable": false,
        "readOnly": true
      },
      "CreatedById": {
        "type": "string",
        "format": "salesforce-id",
        "x-object": "User",
        "maxLength": 18,
        "nullable": false,
        "readOnly": true
      },
      "LastModifiedDate": {
        "type": "string",
        "format": "date-time",
        "nullable": false,
        "readOnly": true
      },
      "LastModifiedById": {
        "type": "string",
        "format": "salesforce-id",
        "x-object": "User",
        "maxLength": 18,
        "nullable": false,
        "readOnly": true
      },
      "SystemModstamp": {
        "type": "string",
        "format": "date-time",
        "nullable": false,
        "readOnly": true
      },
      "MayEdit": {
        "type": "boolean",
        "nullable": false,
        "readOnly": true
      },
      "IsLocked": {
        "type": "boolean",
        "nullable": false,
        "readOnly": true
      },
      "CurrencyIsoCode": {
        "type": "string",
        "description": "CurrencyIsoCode field",
        "format": "enum",
        "enum": [
          "USD"
        ],
        "maxLength": 3,
        "nullable": true
      },
      "QuantityAllocated": {
        "type": "double",
        "description": "The quantity of product items that are allocated but not yet shipped.."
      },
      "QuantityAvailable": {
        "type": "double",
        "description": "The quantity of product items that are currently available in inventory."
      },
      "QuantityDamaged": {
        "type": "double",
        "description": "The quantity of product items that are damaged."
      },
      "QuantityInTransit": {
        "type": "double",
        "description": "The quantity of product items that are currently in transit between locations."
      },
      "QuantityOrdered": {
        "type": "double",
        "description": "The quantity of product items that are ordered from suppliers but not yet received."
      },
      "QtyStateRefreshDate": {
        "type": "string",
        "description": "The date and time when the quantity status of the product item was last updated. The date only changes when the quantity status changes, not when the on-hand quantity changes.",
        "format": "date-time"
      }
    },
