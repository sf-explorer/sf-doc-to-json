{
  "ReturnOrderLineItem": {
    "name": "ReturnOrderLineItem",
    "description": "Represents a product that is returned, recalled, or repaired as part of a return order.",
    "properties": {
      "AssetId": {
        "type": "string",
        "description": "The asset associated with the return order line item.",
        "format": "reference",
        "x-object": "Asset",
        "maxLength": 18,
        "nullable": true
      },
      "Description": {
        "type": "string",
        "description": "The description of the return order line item.",
        "maxLength": 32000,
        "nullable": true
      },
      "DestinationLocationId": {
        "type": "string",
        "description": "The location where the items are being returned to. For example, if the return order tracks the return of products from a technician center to a warehouse, the warehouse is the destination location.",
        "format": "reference",
        "x-object": "Location",
        "maxLength": 18,
        "nullable": true
      },
      "LastReferencedDate": {
        "type": "string",
        "description": "The timestamp when the current user last accessed this record indirectly, for example, through a list view or related record.",
        "format": "date-time",
        "nullable": true,
        "readOnly": true
      },
      "LastViewedDate": {
        "type": "string",
        "description": "The timestamp when the current user last viewed this record or list view. If this value is null, and LastReferenceDate isn’t null, the user accessed this record or list view indirectly.",
        "format": "date-time",
        "nullable": true,
        "readOnly": true
      },
      "OrderItemId": {
        "type": "string",
        "description": "The order product associated with the return order line item.",
        "format": "reference",
        "x-object": "OrderItem",
        "maxLength": 18,
        "nullable": true
      },
      "ProcessingPlan": {
        "type": "string",
        "description": "Specifies the preferred fate of the items after their return. Available values are: Repair—Repair the items and return them to the owner Discard—Discard the items Salvage—Salvage the items’ working parts Restock—Return the items to your inventory",
        "format": "enum",
        "enum": [
          "Repair",
          "Discard",
          "Salvage",
          "Restock"
        ],
        "maxLength": 40,
        "nullable": true
      },
      "Product2Id": {
        "type": "string",
        "description": "The product associated with the return order line item.",
        "format": "reference",
        "x-object": "Product2",
        "maxLength": 18,
        "nullable": true
      },
      "ProductItemId": {
        "type": "string",
        "description": "The product item representing the location of the product at the start of the return.",
        "format": "reference",
        "x-object": "ProductItem",
        "maxLength": 18,
        "nullable": true
      },
      "ProductRequestLineItemId": {
        "type": "string",
        "description": "The product request line item associated with the return order line item.",
        "format": "reference",
        "x-object": "ProductRequestLineItem",
        "maxLength": 18,
        "nullable": true
      },
      "QuantityExpected": {
        "type": "double",
        "description": "The quantity of items expected to be returned.",
        "nullable": true
      },
      "QuantityReceived": {
        "type": "double",
        "description": "The actual quantity of items received for return.",
        "nullable": true
      },
      "QuantityRejected": {
        "type": "double",
        "description": "The quantity of items rejected for return.",
        "nullable": true
      },
      "QuantityReturned": {
        "type": "double",
        "description": "The quantity of items being returned. If multiple types of products are being returned, track each product in a different return order line item.",
        "nullable": false,
        "multipleOf": 0.01
      },
      "QuantityUnitOfMeasure": {
        "type": "string",
        "description": "Units of the returned items. For example, kilograms or liters. Quantity Unit of Measure picklist values are inherited from the Quantity Unit of Measure field on products.",
        "format": "enum",
        "enum": [
          "Each"
        ],
        "maxLength": 40,
        "nullable": true
      },
      "ReasonForRejection": {
        "type": "string",
        "description": "Reason for rejecting returned items on this return order line item.",
        "format": "enum",
        "enum": [
          "Damaged Item",
          "Missing Item or Part",
          "Wrong Item",
          "Expired Warranty"
        ],
        "maxLength": 40,
        "nullable": true
      },
      "ReasonForReturn": {
        "type": "string",
        "description": "The reason the items are being returned. Available values are: Damaged Defective Duplicate Order Wrong Item Wrong Quantity Not Satisfied Outdated Other",
        "format": "enum",
        "enum": [
          "Damaged",
          "Defective",
          "Duplicate Order",
          "Wrong Item",
          "Wrong Quantity",
          "Not Satisfied",
          "Outdated",
          "Other"
        ],
        "maxLength": 40,
        "nullable": true
      },
      "ReasonForChangeText": {
        "type": "string",
        "description": "The details about the reason for the return change"
      },
      "RepaymentMethod": {
        "type": "string",
        "description": "The method by which the customer or owner will be reimbursed for the items being returned. Available values are: Replace—The items will be replaced Refund—The items will be returned and the owner will be refunded Credit—The items will be returned and the owner will receive credit for them Return—The items will be returned to the owner (for example, following their repair)",
        "format": "enum",
        "enum": [
          "Replace",
          "Refund",
          "Credit",
          "Return"
        ],
        "maxLength": 40,
        "nullable": true
      },
      "ReturnOrderId": {
        "type": "string",
        "description": "The return order that the return order line item belongs to.",
        "format": "reference",
        "x-object": "ReturnOrder",
        "maxLength": 18,
        "nullable": false,
        "readOnly": true
      },
      "ReturnOrderLineItemNumber": {
        "type": "string",
        "description": "The auto-generated number that identifies the return order line item.",
        "maxLength": 255,
        "nullable": false,
        "readOnly": true
      },
      "SourceLocationId": {
        "type": "string",
        "description": "The items’ location at the start of the return or repair. For example, if the return order tracks the return of products from a technician’s service center to a warehouse, the service vehicle is the source location.",
        "format": "reference",
        "x-object": "Location",
        "maxLength": 18,
        "nullable": true
      },
      "Id": {
        "type": "string",
        "description": "Return Order Line Item ID",
        "format": "salesforce-id",
        "maxLength": 18,
        "nullable": false,
        "readOnly": true
      },
      "IsDeleted": {
        "type": "boolean",
        "description": "Deleted",
        "nullable": false,
        "readOnly": true
      },
      "CreatedDate": {
        "type": "string",
        "description": "Created Date",
        "format": "date-time",
        "nullable": false,
        "readOnly": true
      },
      "CreatedById": {
