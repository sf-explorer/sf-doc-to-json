        "maxLength": 50,
        "nullable": true,
        "readOnly": true
      },
      "PostalCode": {
        "type": "string",
        "description": "The postal code where the appointment is completed. Maximum length is 20 characters.",
        "maxLength": 20,
        "nullable": true
      },
      "SchedEndTime": {
        "type": "string",
