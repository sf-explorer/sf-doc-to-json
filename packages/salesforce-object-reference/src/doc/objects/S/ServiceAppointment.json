        "format": "reference",
        "x-objects": [
          "Account",
          "Asset",
          "CareProgramEnrollee",
          "Case",
          "Lead",
          "Opportunity",
          "WorkOrder",
          "WorkOrderLineItem"
        ],
        "maxLength": 18,
        "nullable": true,
        "readOnly": true
      },
      "ParentRecordType": {
        "type": "string",
