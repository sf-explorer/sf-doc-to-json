          "Submitted",
          "Completed",
          "Failed",
          "InProgress",
          "Canceled",
          "CompletedWithFailures",
          "QueueingInProgress",
          "Queued"
        ],
        "maxLength": 255,
        "nullable": false
      },
      "Type": {
        "type": "string",
        "description": "The type of batch job that is run.",
