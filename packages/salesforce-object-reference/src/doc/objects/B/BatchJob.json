        "enum": [
          "USD"
        ],
        "maxLength": 3,
        "nullable": true
      },
      "AdditionalInformation": {
        "type": "string",
        "description": "A JSON that contains additional context about the batch jon."
      },
      "ExecutionStage": {
        "type": "string",
        "description": "Specifies the stage at which the batch job's run failed. This field is available in API version 66.0 and later.",
        "enum": []
      },
      "TotalInputRecordCount": {
        "type": "number",
        "description": "The total number of records that were provided as input to the batch job. This field is available in API version 66.0 and later."
      },
      "TotalProcessedRecordCount": {
        "type": "number",
        "description": "The total number of records that were processed by all the batch job parts associated with the batch job. This field is available in API version 66.0 and later."
      },
      "UtilisedExecutionLimit": {
        "type": "string",
        "description": "The CRM Analytics or Data 360 execution capacity utilized by Data Processing Engine batch jobs before the current run started. This field is available in API version 66.0 and later."
      },
      "UtilisedWritebackLimit": {
        "type": "string",
        "description": "The CRM Analytics or Data 360 writeback capacity utilized by Data Processing Engine batch jobs before the current run started. This field is available in API version 66.0 and later."
      }
