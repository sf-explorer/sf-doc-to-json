{
  "BatchJob": {
    "name": "BatchJob",
    "description": "Represents an instance of a batch job that is either running and has been run.",
    "properties": {
      "BatchJobDefinitionId": {
        "type": "string",
        "description": "The unique identifier of the associated batch job definition.",
        "format": "reference",
        "x-object": "BatchJobDefinition",
        "maxLength": 18,
        "nullable": true
      },
      "BatchJobDefinitionName": {
        "type": "string",
        "description": "The developer name of the associated batch job definition.",
        "maxLength": 80,
        "nullable": false
      },
      "EndTime": {
        "type": "string",
        "description": "The timestamp when the batch job run was completed.",
        "format": "date-time",
        "nullable": true
      },
      "ErrorDescription": {
        "type": "string",
        "description": "The error message in case the batch job run failed.",
        "maxLength": 1333,
        "nullable": true
      },
      "ExternalReference": {
        "type": "string",
        "description": "The unique identifier of the process that's running or has run the batch job.",
        "maxLength": 255,
        "nullable": true
      },
      "IsDebugOn": {
        "type": "boolean",
        "description": "Indicates whether debug mode was turned on (true) or not (false) when a definition was run."
      },
      "IsDebugRecipeDeleted": {
        "type": "boolean",
        "description": "Indicates whether debug recipes and datasets were deleted (true) or not (false)."
      },
      "LastReferencedDate": {
        "type": "string",
        "description": "The timestamp for when the current user last viewed the batch job.",
        "format": "date-time",
        "nullable": true,
        "readOnly": true
      },
      "LastViewedDate": {
        "type": "string",
        "description": "The timestamp for when the current user last viewed this item.",
        "format": "date-time",
        "nullable": true,
        "readOnly": true
      },
      "Name": {
        "type": "string",
        "description": "The name of the batch job.",
        "maxLength": 255,
        "nullable": false
      },
      "OwnerId": {
        "type": "string",
        "description": "Unique identifier of the user who initiated the batch job run.",
