{
  "ContentFolderItem": {
    "name": "ContentFolderItem",
    "description": "Represents a file (ContentDocument) or folder (ContentFolder) that resides in a ContentFolder in a ContentWorkspace.",
    "properties": {
      "ContentSize": {
        "type": "number",
        "description": "The size of the file or folder in bytes, when the size is smaller than 2 GB. In API version 66.0 and later, we recommend that you use the ContentSizeLong field even for files smaller than 2 GB.",
        "nullable": true,
        "readOnly": true
      },
      "FileExtension": {
        "type": "string",
        "description": "Specifies the file extension if the ContentFolderItem is a file.",
        "maxLength": 40,
        "nullable": true,
        "readOnly": true
      },
      "FileType": {
        "type": "string",
        "description": "Specifies the type of file if the ContentFolderItem is a file.",
        "maxLength": 20,
        "nullable": true,
        "readOnly": true
      },
      "IsFolder": {
        "type": "boolean",
        "description": "Indicates that the ContentFolderItem is a folder, and not a file.",
        "nullable": false,
        "readOnly": true
      },
      "ParentContentFolderId": {
        "type": "string",
        "description": "The ID of the ContentFolder that the ContentFolderItem resides in.",
        "format": "reference",
        "x-object": "ContentFolder",
        "maxLength": 18,
        "nullable": true,
        "readOnly": true
      },
      "Title": {
        "type": "string",
        "description": "The name of the file or folder.",
        "maxLength": 255,
        "nullable": false,
        "readOnly": true
      },
      "Id": {
        "type": "string",
        "description": "Content Folder Item ID",
        "format": "salesforce-id",
        "maxLength": 18,
        "nullable": false,
        "readOnly": true
      },
      "IsDeleted": {
        "type": "boolean",
        "description": "Deleted",
        "nullable": false,
        "readOnly": true
      },
      "CreatedDate": {
        "type": "string",
        "format": "date-time",
        "nullable": false,
        "readOnly": true
      },
      "CreatedById": {
        "type": "string",
        "format": "salesforce-id",
        "x-object": "User",
        "maxLength": 18,
        "nullable": false,
        "readOnly": true
      },
      "LastModifiedDate": {
        "type": "string",
        "format": "date-time",
        "nullable": false,
        "readOnly": true
      },
      "LastModifiedById": {
        "type": "string",
        "format": "salesforce-id",
        "x-object": "User",
        "maxLength": 18,
        "nullable": false,
        "readOnly": true
      },
      "SystemModstamp": {
        "type": "string",
        "format": "date-time",
        "nullable": false,
        "readOnly": true
      },
      "ContentSizeLong": {
        "type": "number",
        "description": "The size of the file or folder in bytes up to 10 GB. This field is available in API version 66.0 and later."
      }
    },
    "module": "Core Salesforce",
    "sourceUrl": "https://developer.salesforce.com/docs/atlas.en-us.260.0.object_reference.meta/object_reference/sforce_api_objects_contentfolderitem.htm",
