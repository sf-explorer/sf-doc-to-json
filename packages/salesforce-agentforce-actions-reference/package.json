{
  "name": "@sf-explorer/salesforce-agentforce-actions-reference",
  "version": "1.0.0",
  "description": "Salesforce Agentforce standard actions reference from official documentation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/doc/*.json": "./dist/doc/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run copy:doc",
    "build:esm": "tsc",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "copy:doc": "node scripts/copy-doc.js",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "prepare": "npm run build",
    "fetch:actions": "npx tsx scripts/scrape-actions-puppeteer.ts",
    "fetch:actions:basic": "npx tsx scripts/scrape-actions.ts",
    "rebuild-index": "npx tsx scripts/rebuild-index.ts",
    "update-clouds": "npx tsx scripts/update-clouds.ts",
    "update-descriptions": "npx tsx scripts/update-descriptions.ts",
    "update-action-details": "npx tsx scripts/update-action-details.ts",
    "cleanup-api-name": "npx tsx scripts/cleanup-api-name.ts",
    "update-action-count": "npx tsx scripts/update-action-count.ts",
    "test:real-page": "npx tsx scripts/test-real-page-extraction.ts",
    "test:real-page:simple": "npx tsx scripts/test-real-page-simple.ts",
    "save:real-page": "npx tsx scripts/save-real-page.ts",
    "test:real-page:from-file": "npx tsx scripts/test-real-page-from-file.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm test",
    "pack:preview": "npm pack --dry-run"
  },
  "keywords": [
    "salesforce",
    "agentforce",
    "copilot",
    "actions",
    "ai",
    "object-reference",
    "schema",
    "typescript",
    "browser",
    "tree-shakeable",
    "esm"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sf-explorer/sf-doc-to-json.git",
    "directory": "packages/salesforce-agentforce-actions-reference"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "cheerio": "^1.1.2",
    "jest": "^29.7.0",
    "puppeteer": "^24.15.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

